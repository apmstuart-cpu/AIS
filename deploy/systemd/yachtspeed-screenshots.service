[Unit]
Description=yachtspeed: read new MarineTraffic screenshots (Dropbox) by OCR
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yachtspeed
Group=yachtspeed
Environment=YACHTSPEED_CONFIG=/etc/yachtspeed/config.toml
ExecStart=/opt/yachtspeed/.venv/bin/yachtspeed screenshots
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/yachtspeed
