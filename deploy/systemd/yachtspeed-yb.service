[Unit]
Description=yachtspeed YB Tracking (rally tracker) import
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yachtspeed
Group=yachtspeed
Environment=YACHTSPEED_CONFIG=/etc/yachtspeed/config.toml
ExecStart=/opt/yachtspeed/.venv/bin/yachtspeed import-yb
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yachtspeed
